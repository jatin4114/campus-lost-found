NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL connection string (pooled — see docs/database.md)
DATABASE_URL=

# Supabase's direct (non-pooled) connection string, used only by `prisma migrate`.
# Supabase's pooled connection (pgbouncer transaction mode) doesn't support the
# session-level advisory lock migrations need — leave this blank for a plain
# local Postgres container, where DATABASE_URL already is the direct one.
DIRECT_URL=

# JWT secrets (set once auth is implemented)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
